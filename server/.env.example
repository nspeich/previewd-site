# ---------------------------------------------------------------------------
# previewd — configuration du serveur de paiement
#
# 1. Copiez ce fichier en « .env » dans le même dossier.
# 2. Renseignez les deux clés Stripe ci-dessous.
# 3. Redémarrez le serveur.
#
# Le fichier .env ne doit jamais être versionné ni envoyé par courriel.
# ---------------------------------------------------------------------------

# Adresse d'écoute. 127.0.0.1 pour un usage local ; 0.0.0.0 derrière un reverse
# proxy, avec TLS assuré par ce proxy.
HOST=127.0.0.1
PORT=8787

# Origine publique utilisée pour les URL de retour après paiement.
# En production : https://votre-domaine.tld
PUBLIC_BASE_URL=http://localhost:8787

# Devise des abonnements (code ISO 4217).
CURRENCY=eur

# Clé secrète Stripe. Tableau de bord → Développeurs → Clés API.
# Commence par sk_test_ en mode test, sk_live_ en production.
STRIPE_SECRET_KEY=

# Secret de signature du webhook. Tableau de bord → Développeurs → Webhooks,
# ou « stripe listen » en local (il affiche un whsec_...).
STRIPE_WEBHOOK_SECRET=

# Réservé aux tests automatisés : permet de pointer l'API vers un faux Stripe
# local. Ne pas renseigner en production.
# STRIPE_API_BASE=http://127.0.0.1:9999
